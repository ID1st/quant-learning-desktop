{
  "name": "quant-learning-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @quant/desktop",
    "build": "npm run build -w @quant/desktop",
    "build:cloud": "npm run build -w @quant/cloud-server",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "coverage": "node scripts/run-coverage.mjs",
    "test:api-client": "node --test --experimental-strip-types packages/api-client/tests/*.test.ts",
    "test:cloud": "npm run test -w @quant/cloud-server",
    "test:chart": "node --test --experimental-strip-types packages/chart/tests/*.test.ts",
    "test:desktop": "node --test --experimental-strip-types apps/desktop/tests/*.test.ts",
    "test:pine-runtime": "node --test --experimental-strip-types packages/pine-runtime/tests/*.test.ts",
    "test:plugin-loader": "node --test --experimental-strip-types packages/plugin-loader/tests/*.test.ts",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "probe:longport:a-share": "node scripts/longport-a-share-probe.mjs",
    "probe:stock-sdk": "node --experimental-strip-types scripts/stock-sdk-provider-probe.mjs",
    "drill:market-data": "node --experimental-strip-types scripts/market-data-stability-drill.mjs",
    "check:market-calendar": "node --experimental-strip-types scripts/check-market-calendar-coverage.mts",
    "smoke:market-data-search": "npm run build:electron -w @quant/desktop && node scripts/market-data-search-electron-smoke.mjs",
    "smoke:auth": "npm run build:electron -w @quant/desktop && node scripts/auth-electron-smoke.mjs",
    "smoke:auth:visual": "node scripts/auth-visual-electron-smoke.mjs",
    "smoke:plugin-runtime": "npm run build:electron -w @quant/desktop && node scripts/plugin-runtime-electron-smoke.mjs",
    "optimize:preset-strategies": "node --experimental-strip-types scripts/preset-strategy-parameter-sweep.mjs",
    "test:strategy-engine": "node --test --experimental-strip-types packages/strategy-engine/tests/*.test.ts",
    "test": "npm run test:api-client && npm run test:cloud && npm run test:chart && npm run test:desktop && npm run test:pine-runtime && npm run test:plugin-loader && npm run test:strategy-engine && npm run test:release",
    "auth:invite:batch-create": "npm run auth:invite:batch-create -w @quant/cloud-server --",
    "auth:invite:batch-verify": "npm run auth:invite:batch-verify -w @quant/cloud-server --",
    "auth:admin:provision": "npm run auth:admin:provision -w @quant/cloud-server --",
    "ops:cloud:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/codex-cloud-audit.ps1",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run coverage",
    "check": "npm run quality && npm run build:cloud && npm run build && npm run build:electron -w @quant/desktop",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "electron-builder": "26.15.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "stock-sdk": "2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  }
}
