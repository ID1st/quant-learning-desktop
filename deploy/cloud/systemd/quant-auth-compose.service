[Unit]
Description=Quant Learning Authentication Service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/quant-auth/current
ExecStartPre=/usr/bin/docker compose -f deploy/cloud/docker-compose.yml config --quiet
ExecStart=/usr/bin/docker compose -f deploy/cloud/docker-compose.yml up -d --build
ExecStartPost=/opt/quant-auth/current/deploy/cloud/scripts/wait-ready.sh
ExecStop=/usr/bin/docker compose -f deploy/cloud/docker-compose.yml down
ExecReload=/usr/bin/docker compose -f deploy/cloud/docker-compose.yml up -d --build
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
