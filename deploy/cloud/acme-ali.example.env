# Store the real file at /opt/quant-auth/secrets/acme-ali.env with mode 600.
# Use a dedicated RAM user with no console login and only the AliDNS actions
# required to add, inspect, and remove ACME TXT records for fnndp.xyz.
Ali_Key=replace-with-dedicated-ram-access-key-id
Ali_Secret=replace-with-dedicated-ram-access-key-secret
ACME_EMAIL=replace-with-operations-email
