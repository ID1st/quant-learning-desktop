{
  "name": "@quant/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "量化学习桌面版工作台",
  "author": "Quant Learning Desktop Team",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "electron-vite dev",
    "build": "vite build",
    "build:electron": "electron-vite build",
    "package:dir": "node ../../scripts/package-desktop.mjs --dir",
    "package:win": "node ../../scripts/package-desktop.mjs --win nsis",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "build": {
    "appId": "com.quantlearning.desktop",
    "productName": "量化学习桌面版",
    "electronVersion": "42.5.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@duckdb/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.2",
    "@quant/api-client": "*",
    "@quant/chart": "*",
    "@quant/plugin-loader": "*",
    "@quant/shared": "*",
    "@quant/strategy-engine": "*",
    "@quant/ui": "*",
    "longbridge": "^4.3.3",
    "stock-sdk": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "electron": "42.5.1",
    "electron-vite": "^5.0.0"
  }
}
