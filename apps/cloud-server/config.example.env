DATABASE_URL=postgresql://quant_auth:replace-with-url-encoded-password@postgres:5432/quant_auth

AUTH_HOST=0.0.0.0
AUTH_PORT=8787
AUTH_LOG_LEVEL=info
AUTH_INVITE_CODE_PEPPER=replace-with-at-least-32-random-bytes
AUTH_TOKEN_PEPPER=replace-with-a-different-32-byte-secret
AUTH_EMAIL_CODE_PEPPER=replace-with-a-different-32-byte-secret
AUTH_LOGIN_CHALLENGE_SECRET=replace-with-a-different-32-byte-secret
AUTH_OFFLINE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
AUTH_OFFLINE_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----
AUTH_INVITE_EXPORT_DIR=/opt/quant-auth/secrets/invite-exports

# Leave AUTH_SMTP_HOST unset until the DirectMail sender domain and address pass verification.
# AUTH_SMTP_HOST=smtpdm.aliyun.com
# AUTH_SMTP_PORT=465
# AUTH_SMTP_SECURE=true
# AUTH_SMTP_USER=no-reply@notify.fnndp.xyz
# AUTH_SMTP_PASSWORD=replace-me
# AUTH_SMTP_FROM=量化学习系统 <no-reply@notify.fnndp.xyz>
